# ── Site ──────────────────────────────────────────────────────────────
# Your public origin (canonical URLs, sitemap, social cards). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# Shown in the footer, policies, contact page and on the PayPal payment sheet.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_LEGAL_NAME=Your Business Name LLC

# ── PayPal checkout (developer.paypal.com → Apps & Credentials) ───────
# Use the Sandbox app's credentials first, then swap in Live ones and set PAYPAL_ENV=live.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ── Notifications (optional) ──────────────────────────────────────────
# Each paid order (item, color, qty, total, buyer email, shipping address) is POSTed here as JSON.
# Point it at a Zapier/Make "Catch Hook" that emails you or adds a row to a sheet.
# Every order is also visible in your PayPal account either way.
ORDER_WEBHOOK_URL=
# Review submissions are POSTed here for you to moderate. Empty = review form says reviews aren't open.
REVIEW_WEBHOOK_URL=

# ── Analytics (optional, consent-gated) ───────────────────────────────
# Google tag (G-… or AW-…). Empty disables Google measurement.
NEXT_PUBLIC_GOOGLE_TAG_ID=
