# Public origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Your affiliate link (AliExpress Portals) or own checkout for the FM-1. Defaults to the plain listing URL.
NEXT_PUBLIC_BUY_URL=
# Optional: query parameter on the buy URL that carries per-button sub-tracking.
NEXT_PUBLIC_BUY_SUBPARAM=
# Google tag (G-… or AW-…). Empty disables Google measurement.
NEXT_PUBLIC_GOOGLE_TAG_ID=
